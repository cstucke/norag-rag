# Copy this file to .env (or .env.local, which wins over .env) and replace with your real values.

# The app (uvicorn app.main:app) talks to any OpenAI-compatible LLM server. All three are needed.
# The values below are Google Gemini's: create a key at https://aistudio.google.com/app/api-keys
# and paste it as LLM_API_KEY. For another server, change the URL and the model id too.
LLM_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY="your_api_key_here"
LLM_MODEL="gemini-3.5-flash"

# Only for the course demo scripts (ask_norag_google.py, ask_rag_google.py, bm25/)
export GOOGLE_API_KEY="your_google_api_key_here"
